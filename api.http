###
# @name createCategory
POST http://localhost:3000/categories
Content-Type: application/json

{
  "name": "Category 1",
  "description": "Description 1"
}

> {% client.global.set("categoryId", response.body.data.id) %}

###
# @name createGenre
POST http://localhost:3000/genres
Content-Type: application/json

{
  "name": "Genre 1",
  "categories_id": ["{{categoryId}}"]
}


> {% client.global.set("genreId", response.body.data.id) %}

###
# @name createCastMember
POST http://localhost:3000/cast-members
Content-Type: application/json

{
  "name": "Virgulino",
  "type": 2
}

> {% client.global.set("castMemberId", response.body.data.cast_member_id) %}

### Create Vídeo
POST http://localhost:3000/videos
Content-Type: application/json

{
  "title": "Video 1",
  "description": "Description 1",
  "year_launched": 2020,
  "is_opened": false,
  "rating": "L",
  "duration": 90,
  "categories_id": [
    "{{categoryId}}"
  ],
  "genres_id": [
    "{{genreId}}"
  ],
  "cast_members_id": [
    "{{castMemberId}}"
  ]
}

> {% client.global.set("videoId", response.body.data.id) %}

### Get Vídeo
GET http://localhost:3000/videos/{{videoId}}

